module sh.sysl.json

import sysl.buf.{Buf, buf}
import sysl.text.parse_real

// The value, and the two things a caller does with one that a `match` does not do well: ask what it
// is, and reach into it by name or by position.
//
// **The tree owns itself.** An array holds `Buf[Json]` and an object holds `Buf[Member]` -- no `&`
// anywhere, which is what makes this package worth writing rather than copying. A `Buf[T]` stores
// its elements in a slice it allocates, so the recursion goes through a pointer the buffer holds
// rather than through one the type declares, and `Json` has a finite size all the same. Every walk
// over a document is therefore `j match` on an ordinary value; nothing has to be dereferenced first.
//
// **A document read here keeps the order it was written in.** Members are a sequence rather than a
// map, so `{"b":1,"a":2}` renders back the way it arrived and `get` is a linear scan. That is the
// right trade for the sizes JSON is used at -- a configuration file, a request body, a message --
// and it is the only representation that can round-trip, which is what a reader and a writer in one
// package are for.

/** One member of an object: the name it was written under, and what was written there.
 *
 * A named struct rather than a pair, because it is a public payload: a caller walking an object
 * reads `m.key` and `m.value`, which a tuple's positions cannot say. It is also what forces this
 * package's compiler floor -- see `package.hocon`.
 */
struct Member
    key: string
    value: Json

/** A JSON value: one of the eight things the grammar can produce.
 *
 * **Numbers are three variants rather than one.** JSON's grammar has a single numeric production and
 * says nothing about how it is stored, so a reader has to choose, and no one choice is right for
 * everybody: carrying every number as a `real` loses the exact value of an integer past 2^53, which
 * is where an identifier or a timestamp in milliseconds lives, and carrying every number as a `long`
 * cannot represent `0.5` at all -- nor `10^30`, which a program whose integers are arbitrary
 * precision writes without thinking about it and every JavaScript host reads back. So `Int` is a
 * whole number that fits a `long`, `Real` is anything written with a fraction or an exponent, `Big`
 * is a whole number past what a `long` holds in either direction, and a caller that does not care
 * asks `as_real`.
 *
 * **`Big` carries the digits rather than a `BigInt`**, because a document is text and what this
 * package owes is the text back: the digits round-trip exactly, cost one string, and ask nothing of
 * a consumer that is only moving a number from one document to another. A consumer that has to
 * *compute* with one calls `to_bigint` and pays for the conversion where it asked for it, which is
 * what keeps `sysl.math.bigint` out of every program that only reads a configuration file.
 *
 * **The reader never answers `Big` where a `long` would hold the value**, and nothing else should
 * either: `Big("5")` renders as `5` and reads back as `Int(5)`, so a document built that way does
 * not equal itself after a round trip. `from_bigint` is the constructor that keeps the rule.
 */
enum Json
    Null
    Bool(b: bool)
    Int(n: long)
    Big(digits: string)
    Real(x: real)
    Str(s: string)
    Arr(items: Buf[Json])
    Obj(members: Buf[Member])

    /** Whether this is the null value -- which is a value here, not the absence of one. `get` on a
     * missing member answers `None`; `get` on one written as `null` answers `Some(Null)`, and a
     * caller that has to tell the two apart can.
     */
    is_null(self) -> bool = self match
        Null -> true
        _ -> false

    is_bool(self) -> bool = self.as_bool().is_some()

    is_number(self) -> bool = self match
        Int(_) -> true
        Big(_) -> true
        Real(_) -> true
        _ -> false

    is_str(self) -> bool = self.as_str().is_some()

    is_array(self) -> bool = self match
        Arr(_) -> true
        _ -> false

    is_object(self) -> bool = self match
        Obj(_) -> true
        _ -> false

    /** The boolean this is, or `None` for every other shape.
     *
     * The `as_*` family never converts and never coerces: a string reading `"true"` is a string, and
     * `Str("1").as_int()` is `None`. What a JSON document meant is the document's business, so a
     * caller that wants a number out of a string says so by reaching for `sysl.text`'s parsers.
     */
    as_bool(self) -> Option[bool] = self match
        Bool(b) -> Some(b)
        _ -> None

    /** The integer this is -- only where the document wrote one that fits. `1.0` was written with a
     * fraction, so it is a `Real` and this answers `None`, and so is a whole number past a `long`,
     * which is a `Big`. The caller that would take any of them asks `as_real`, and the caller that
     * wants the exact value of a large one asks `to_bigint`.
     */
    as_int(self) -> Option[long] = self match
        Int(n) -> Some(n)
        _ -> None

    /** The digits of a whole number too large for a `long`, exactly as the document wrote them and
     * with the sign where it wrote it. `None` for every other shape, an `Int` included: a caller
     * reaching for this is asking for what `as_int` could not answer.
     */
    as_big(self) -> Option[string] = self match
        Big(d) -> Some(d)
        _ -> None

    /** The number this is, whichever variant carries it.
     *
     * **This is the one accessor that widens**, because the split between the numeric variants is
     * about not losing what the document said, and a caller doing arithmetic in floating point has
     * already decided it does not care. Every `long` up to 2^53 widens exactly; past that the
     * conversion rounds, which is the same thing every JSON reader that has only floats does to
     * every number -- and a `Big` is that same rounding of its digits, correctly rounded however
     * many of them there are, to an infinity where they name a value past every finite `real`. The
     * `None` is for the digits a reader cannot produce, a hand-built `Big` holding something that
     * is not a number.
     */
    as_real(self) -> Option[real] = self match
        Real(x) -> Some(x)
        Int(n) -> Some(real(n))
        Big(d) -> parse_real(d) match
            Ok(x) -> Some(x)
            Err(_) -> None
        _ -> None

    as_str(self) -> Option[string] = self match
        Str(s) -> Some(s)
        _ -> None

    /** How many elements an array has, or how many members an object has. Anything else is zero,
     * which is what makes `for i in 0..<j.len()` safe to write against a value whose shape has not
     * been checked yet.
     */
    len(self) -> usize = self match
        Arr(items) -> items.len()
        Obj(members) -> members.len()
        _ -> 0

    /** The element at a position, for an array. `None` for an index past the end and `None` for a
     * value that is not an array -- the two are the same answer on purpose, since a caller reaching
     * into a document it did not write cannot usefully distinguish them.
     */
    at(self, i: usize) -> Option[Json] = self match
        Arr(items) -> if i < items.len() then Some(items.at(i)) else None
        _ -> None

    /** The member at a position, for an object -- name and value together, in the order the document
     * wrote them. This is how an object is walked when the names are not known in advance.
     */
    member(self, i: usize) -> Option[Member] = self match
        Obj(members) -> if i < members.len() then Some(members.at(i)) else None
        _ -> None

    /** The value written under a name, or `None` where there is none.
     *
     * **The scan is linear and the first match wins.** JSON permits a name to appear twice and says
     * nothing about what that means; every reader has to pick, and picking the first keeps this
     * agreeing with what a caller walking the members in order would find.
     */
    get(self, key: string) -> Option[Json]
        self match
            Obj(members) ->
                for i in 0..<members.len()
                    val m = members.at(i)

                    if m.key == key then return Some(m.value)

                None
            _ -> None
    end get

    /** Whether an object has a member of this name, `null` included. */
    has(self, key: string) -> bool = self.get(key).is_some()
end Json

/** Two members are equal when they were written under the same name and hold equal values. */
impl Eq for Member
    eq(self, rhs: Member) -> bool = self.key == rhs.key && self.value == rhs.value

/** Two values are equal when they are the same shape holding equal things.
 *
 * **The numeric variants do not meet**, so `Int(1)` and `Real(1.0)` are not equal. That reads oddly
 * beside `1 == 1.0` in the language and it is the only defensible answer here: this equality is
 * about two *documents* saying the same thing, and `1` and `1.0` are two different texts that a
 * round trip has to keep apart. A caller comparing numbers regardless of how they were written has
 * `as_real` and the language's own `==`.
 *
 * **Two `Big`s are equal when their digits are**, which is the same rule one step further along: a
 * value the reader produced is the text the document held, and the grammar has already refused a
 * leading zero and a leading `+`, so the digits of two documents agreeing on a number agree
 * byte for byte. A caller comparing a hand-built `Big` against a read one compares it through
 * `to_bigint`.
 *
 * **Objects compare in order.** `{"a":1,"b":2}` and `{"b":2,"a":1}` are not equal, for the same
 * reason: what is held is the sequence the document wrote, and a reordering is a different text.
 */
impl Eq for Json
    eq(self, rhs: Json) -> bool
        self match
            Null -> rhs.is_null()
            Bool(a) -> rhs match
                Bool(b) -> a == b
                _ -> false
            Int(a) -> rhs match
                Int(b) -> a == b
                _ -> false
            Big(a) -> rhs match
                Big(b) -> a == b
                _ -> false
            Real(a) -> rhs match
                Real(b) -> a == b
                _ -> false
            Str(a) -> rhs match
                Str(b) -> a == b
                _ -> false
            Arr(a) -> rhs match
                Arr(b) ->
                    if a.len() != b.len() then return false

                    for i in 0..<a.len()
                        if a.at(i) != b.at(i) then return false

                    true
                _ -> false
            Obj(a) -> rhs match
                Obj(b) ->
                    if a.len() != b.len() then return false

                    for i in 0..<a.len()
                        val x = a.at(i)
                        val y = b.at(i)

                        if x.key != y.key || x.value != y.value then return false

                    true
                _ -> false
    end eq
end Json
